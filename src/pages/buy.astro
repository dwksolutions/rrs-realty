---
import Layout from '../layouts/Layout.astro';
import LeadForm from '../components/LeadForm.astro';

// FAQ content drives both the visible cards below and the FAQPage structured
// data, so the two never drift (Google requires them to match).
const faqs = [
  {
    q: 'Does it cost anything to get matched with a buyer agent?',
    a: 'Getting matched through RRS is free, and there is no obligation. Any services and compensation with the agent you choose are set out in your written buyer agreement, which you review before you tour homes. Buyer agent compensation is negotiable.',
  },
  {
    q: 'I am not ready to buy yet. Should I still reach out?',
    a: 'Yes. Many buyers talk with us months ahead, just to understand neighborhoods, prices, and what their timeline could look like. Getting matched does not commit you to buying anything.',
  },
  {
    q: 'How do you choose which agent to match me with?',
    a: 'A real person from RRS talks with you first about where you want to live, your budget, and your must-haves. We then connect you with a licensed local agent who knows those specific communities.',
  },
  {
    q: 'Do you help first-time buyers?',
    a: 'Absolutely. We match first-time buyers with patient, local agents who will walk you through financing, offers, and inspections step by step. Our local guides are a good place to start too.',
  },
  {
    q: 'Which areas do you cover for buyers?',
    a: 'All eight counties of Southeast Wisconsin, from Milwaukee and Waukesha to Racine, Kenosha, Ozaukee, Washington, Walworth, and Jefferson, including the surrounding communities.',
  },
  {
    q: 'How soon will someone reach out?',
    a: 'Quickly. A real person from RRS reaches out personally to start the conversation, so you are not left waiting in a queue for a stranger to call.',
  },
];

const faqSchema = {
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<Layout
  current="buy"
  title="Buy a Home in Southeast Wisconsin, Get Matched With a Local Buyer Agent | RRS Realty Group"
  description="Buying a home in Southeast Wisconsin? Get personally matched with a vetted, licensed local buyer agent. A real person reaches out and hand-matches you. Free, no obligation."
  jsonLd={[faqSchema]}
>
  <section class="section" style="padding:64px 0">
    <div class="wrap split">
      <div>
        <p class="eyebrow">For buyers</p>
        <h1 style="font-size:clamp(2.1rem,4vw,3rem)">Buy Your Home With a Local Agent on Your Side</h1>
        <p class="intro">The right buyer agent knows the streets, the schools, and how to win the home you want. Tell us what you're looking for and a real person from RRS reaches out, listens, and hand-matches you with a vetted local agent. It's free, there's no obligation, and it takes under two minutes.</p>
        <ul class="hero-trust" style="margin-top:8px">
          <li><span class="dot"></span> Vetted local buyer agents</li>
          <li><span class="dot"></span> No charge from RRS to get matched</li>
          <li><span class="dot"></span> No obligation</li>
          <li><span class="dot"></span> Serving all of Southeast Wisconsin</li>
        </ul>
      </div>
      <LeadForm heading="Find Your Next Home" sub="Tell us what you're looking for." intent="Buying" />
    </div>
  </section>

  <section class="section area">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">For buyers</p>
        <h2>What Wins the Right Home</h2>
        <p>Buying well in Southeast Wisconsin comes down to being ready and knowing the ground. Here is where a local buyer agent makes the difference.</p>
      </div>
      <div class="why-grid">
        <div class="why-card"><div class="ic">🏦</div><h3>Line Up Your Financing First</h3><p>Talk to a lender and get pre-approved before you shop, so you know your budget and can move quickly when the right home appears. A strong pre-approval also makes your offer more competitive.</p></div>
        <div class="why-card"><div class="ic">📍</div><h3>Know the Neighborhoods</h3><p>Prices, commutes, and what homes actually sell for shift block to block here. A local buyer agent knows the streets. Start with our <a href="/home-values/">city market data</a> and our guide on <a href="/guides/how-to-choose-a-real-estate-agent-southeast-wisconsin/">choosing the right agent</a>.</p></div>
        <div class="why-card"><div class="ic">✍️</div><h3>Make a Competitive Offer</h3><p>In tight markets the winning offer balances price with contingencies, closing date, and earnest money, not just the top number. A local agent helps you compete without overpaying.</p></div>
        <div class="why-card"><div class="ic">🔎</div><h3>Inspect With Wisconsin in Mind</h3><p>Budget for a home inspection and watch what our climate makes matter: basement moisture, the roof and gutters, furnace age, and radon. It is your best protection before you commit.</p></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap" style="max-width:44rem;margin:0 auto;text-align:center">
      <p class="eyebrow">A personal process</p>
      <h2>The Matching Part Is Simple</h2>
      <p class="intro">Tell us what you're looking for, a real person reaches out to understand your must-haves, and we hand-match you with the right local buyer agent. No anonymous queue, no random handoff.</p>
      <a class="btn btn-ghost" href="/how-it-works/">See the full process →</a>
    </div>
  </section>

  <section class="section area">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Common questions</p>
        <h2>Buying FAQ</h2>
      </div>
      <div class="why-grid">
        {faqs.map((f) => (
          <div class="why-card"><h3>{f.q}</h3><p>{f.a}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="cta">
    <div class="wrap">
      <h2>Ready to Find Your Home?</h2>
      <p>Get matched with a trusted Southeast Wisconsin buyer agent today. Free, no obligation, no pressure.</p>
      <a class="btn btn-primary" href="/get-started/">Find my agent →</a>
    </div>
  </section>
</Layout>
