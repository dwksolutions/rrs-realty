---
import Layout from '../../layouts/Layout.astro';
import { marketCities, citiesByCounty } from '../../data/cities.js';

// Only cities with a page. Some communities we serve have too little listing
// activity to publish figures for, and they live on the service area page.
const withPages = marketCities();
const counties = citiesByCounty(withPages);

const title = 'Southeast Wisconsin Market Data by City | RRS Realty Group';
const description = 'Explore market data across Southeast Wisconsin: median list price, days on market, and price per square foot by city. Get a free local home valuation.';

const origin = new URL(Astro.site).origin;
const hubUrl = origin + '/home-values/';

const breadcrumb = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: origin + '/' },
    { '@type': 'ListItem', position: 2, name: 'Market Data', item: hubUrl },
  ],
};
// The full set of city pages this hub indexes, in the same order they appear.
const itemList = {
  '@type': 'ItemList',
  '@id': hubUrl + '#list',
  numberOfItems: withPages.length,
  itemListElement: counties
    .flatMap((g) => g.cities)
    .map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `${origin}/home-values/${c.slug}/`,
      name: `${c.name}, WI home values`,
    })),
};
---
<Layout current="values" title={title} description={description} jsonLd={[itemList, breadcrumb]}>
  <section class="page-head">
    <div class="wrap">
      <p class="eyebrow">Market data</p>
      <h1>Southeast Wisconsin Home Values</h1>
      <p>Median prices and market trends by city. Pick your town for a local snapshot, then get a free valuation of your specific home.</p>
      <p style="margin-top:14px"><a class="btn btn-ghost" href="/home-values/compare/">Compare all {withPages.length} cities in one table →</a></p>
    </div>
  </section>

  <section class="section" style="padding-top:44px">
    <div class="wrap" style="max-width:60rem">
      {counties.map((group) => (
        <div class="mkt-group">
          <h2>{group.county}</h2>
          <div class="mkt-pills">
            {group.cities.map((c) => (
              <a href={`/home-values/${c.slug}/`}>{c.name}</a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="cta">
    <div class="wrap">
      <h2>Want Your Home's Real Value?</h2>
      <p>Market averages are a starting point. Get matched with a local agent for a free, no-obligation valuation of your specific home.</p>
      <a class="btn btn-primary" href="/get-started/">Find my agent →</a>
    </div>
  </section>
</Layout>
