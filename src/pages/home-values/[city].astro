---
import Layout from '../../layouts/Layout.astro';
import LeadForm from '../../components/LeadForm.astro';
import { cities, getCity } from '../../data/cities.js';
import { getMarketStats, fmtPrice, fmtNum, fmtYoY } from '../../lib/marketData.js';
import { getSampleCaveat, isVolatileSample } from '../../lib/marketCaveats.js';

export async function getStaticPaths() {
  return cities.map((city) => ({ params: { city: city.slug }, props: { city } }));
}

const { city } = Astro.props;
const stats = await getMarketStats(city);
const updated = stats.updated.toLocaleDateString('en-US', { year: 'numeric', month: 'long' });
const nearby = (city.nearby || []).map(getCity).filter(Boolean);
// Flags a thin sample so the numbers are not read as more precise than they are.
const sampleCaveat = getSampleCaveat(city, stats);

// Figures cover every ZIP assigned to this city, which is 22 for Milwaukee and
// one for most suburbs. The page says which, rather than implying full coverage.
const zips = stats.zips || [city.zip];
const zipLabel = zips.length === 1 ? `ZIP ${zips[0]}` : `${zips.length} ZIP codes`;
// Milwaukee spans 22 ZIPs, which is a wall of digits in a footnote. Lead with
// the biggest few (the list is sorted by listing count) and count the rest.
const zipsShown = zips.slice(0, 6);
const zipsRest = zips.length - zipsShown.length;
// Year over year is the noisiest figure here, so a thin sample hides it entirely
// rather than presenting a swing that reflects a handful of listings.
const yoy = isVolatileSample(stats) ? null : fmtYoY(stats.priceYoY);

const title = `${city.name}, WI Home Values | RRS Realty Group`;
const description = `${city.name}, WI market snapshot: median list price, days on market, and price per sq ft across ${zipLabel}. Get a free local home valuation.`;

const origin = new URL(Astro.site).origin;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const breadcrumb = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: origin + '/' },
    { '@type': 'ListItem', position: 2, name: 'Market Data', item: origin + '/home-values/' },
    { '@type': 'ListItem', position: 3, name: city.name, item: canonical },
  ],
};

// Ties the page to the actual place it covers, so the city, its county, and the
// ZIP are unambiguous rather than inferred from the copy.
const place = {
  '@type': 'City',
  '@id': canonical + '#place',
  name: `${city.name}, Wisconsin`,
  address: {
    '@type': 'PostalAddress',
    addressLocality: city.name,
    addressRegion: 'WI',
    // Only claim a postal code when the page really covers just that one.
    ...(zips.length === 1 ? { postalCode: zips[0] } : {}),
    addressCountry: 'US',
  },
  containedInPlace: {
    '@type': 'AdministrativeArea',
    name: `${city.county}, Wisconsin`,
    containedInPlace: { '@type': 'State', name: 'Wisconsin' },
  },
};
const webPage = {
  '@type': 'WebPage',
  '@id': canonical + '#webpage',
  url: canonical,
  name: title,
  description,
  about: { '@id': place['@id'] },
  isPartOf: { '@id': origin + '/#website' },
  primaryImageOfPage: new URL('/og-image.png', Astro.site).href,
  ...(stats.isEstimate ? {} : { dateModified: stats.updated.toISOString() }),
};
---
<Layout current="values" title={title} description={description} jsonLd={[place, webPage, breadcrumb]}>
  <section class="page-head" style="padding-bottom:8px">
    <div class="wrap" style="max-width:52rem">
      <p class="breadcrumb"><a href="/">Home</a> › <a href="/home-values/">Market Data</a> › {city.name}</p>
      <h1>{city.name}, WI home values &amp; market trends</h1>
      <p>A market snapshot for the {city.name} area in {city.county}, covering {zipLabel}. These are current <em>listing</em> figures, not closed sales. For what <em>your</em> specific home is worth, get matched with a local agent below.</p>
    </div>
  </section>

  <section class="section" style="padding-top:40px">
    <div class="wrap">
      {stats.isEstimate && (
        <div class="sample-banner" style="max-width:52rem;margin-left:auto;margin-right:auto">
          <b>Estimated figures.</b> Current market data for {city.name} hasn't been added yet. Get matched with a local agent below for real, up-to-date numbers.
        </div>
      )}

      <div class={yoy ? 'stat-grid stat-grid-5' : 'stat-grid'}>
        <div class="stat">
          <p class="label">Median list price</p>
          <p class="value">{fmtPrice(stats.medianPrice)}</p>
          <p class="sub">Median asking price</p>
        </div>
        {yoy && (
          <div class="stat">
            <p class="label">Year over year</p>
            <p class="value">{yoy}</p>
            <p class="sub">Change in median list price</p>
          </div>
        )}
        <div class="stat">
          <p class="label">Days on market</p>
          <p class="value">{fmtNum(stats.daysOnMarket)}</p>
          <p class="sub">Median for current listings</p>
        </div>
        <div class="stat">
          <p class="label">Price / sq ft</p>
          <p class="value">{fmtPrice(stats.pricePerSqft)}</p>
          <p class="sub">Median list, per sq ft</p>
        </div>
        <div class="stat">
          <p class="label">Active listings</p>
          <p class="value">{fmtNum(stats.activeListings)}</p>
          <p class="sub">Homes currently for sale</p>
        </div>
      </div>

      {sampleCaveat && <p class="sample-note">{sampleCaveat}</p>}

      <p class="data-note" style="text-align:center">
        Covers {zips.length === 1 ? 'ZIP' : 'ZIPs'} {zipsShown.join(', ')}{zipsRest > 0 ? ` and ${zipsRest} more` : ''} ·
        Listing data via <a href="https://www.realtor.com/research/data/" rel="nofollow">Realtor.com</a> · Updated {updated}
      </p>
    </div>
  </section>

  <section class="section area" style="padding-top:56px">
    <div class="wrap">
      <div class="context-card">
        <h2>About the {city.name} market</h2>
        <p>{city.blurb}</p>
      </div>

      {nearby.length > 0 && (
        <div style="text-align:center;margin-top:34px">
          <p class="eyebrow" style="margin-bottom:10px">Nearby markets</p>
          <div class="nearby-links">
            {nearby.map((n) => (
              <a href={`/home-values/${n.slug}/`}>{n.name} home values →</a>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  <section class="section" style="padding-top:64px">
    <div class="wrap split">
      <div>
        <p class="eyebrow">Free home valuation</p>
        <h2 style="font-size:clamp(2rem,3.6vw,2.6rem)">What's your {city.name} home actually worth?</h2>
        <p class="intro">Market averages are a starting point, but your home's real value depends on its condition, updates, and exact location. Get matched with a vetted {city.name}-area agent for a free, no-obligation valuation of your specific home.</p>
        <ul class="hero-trust" style="margin-top:8px">
          <li><span class="dot"></span> A real local agent, not an algorithm</li>
          <li><span class="dot"></span> Free &amp; no obligation</li>
          <li><span class="dot"></span> Based on your home's actual details</li>
        </ul>
      </div>
      <LeadForm heading={`Get your ${city.name} home valued`} sub="A local agent will prepare your free valuation." />
    </div>
  </section>

  <p class="disclaimer wrap">
    Market statistics shown are aggregate listing figures for the ZIP codes noted above, combined across ZIPs and weighted by the number of active listings in each. ZIP code areas are set by the postal service and do not match city limits exactly, so the coverage is an approximation of the {city.name} market rather than an exact match for it. These figures are for general informational purposes and are not an appraisal or valuation of any specific property. They reflect homes currently or recently listed, not closed sales, and vary by condition, location, and features. For a valuation of your home, consult a licensed real estate professional.
  </p>
  <div style="height:64px"></div>
</Layout>
