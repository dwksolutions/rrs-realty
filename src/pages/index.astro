---
import Layout from '../layouts/Layout.astro';
import LeadForm from '../components/LeadForm.astro';
import { getCollection } from 'astro:content';
import { getCity, citiesByCounty } from '../data/cities.js';
import ServiceMap from '../components/ServiceMap.astro';
import { getRegionSnapshot, getRegionTrend } from '../lib/marketRegion.js';
import { fmtPrice, fmtNum } from '../lib/marketData.js';

const posts = (await getCollection('guides', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date - a.data.date)
  .slice(0, 3);
const thumbs = ['', 'b2', 'b3'];

// Featured cities for the "where we work" strip, pulled from the single
// source so we never show a city without a market-data page.
const featuredCities = ['milwaukee', 'wauwatosa', 'brookfield', 'waukesha', 'new-berlin', 'mequon', 'cedarburg', 'menomonee-falls', 'oak-creek', 'franklin', 'west-bend', 'germantown', 'racine', 'kenosha', 'lake-geneva', 'watertown']
  .map(getCity)
  .filter(Boolean);

// Live figures instead of assertions. Both refresh on every data import.
const region = getRegionSnapshot();
const trend = getRegionTrend();
const trendMonth = new Date(Number(region.month.slice(0, 4)), Number(region.month.slice(4)) - 1, 1)
  .toLocaleDateString('en-US', { year: 'numeric', month: 'long' });
const pctUp = Math.round(trend.priceChange * 100);
const pctDown = Math.round(Math.abs(trend.listingChange) * 100);

// What we actually offer, stated explicitly: free agent matching across the same
// counties cities.js covers, so the service area never drifts from the site.
const origin = new URL(Astro.site).origin;
const service = {
  '@type': 'Service',
  '@id': origin + '/#service',
  name: 'Real Estate Agent Matching',
  serviceType: 'Real estate agent referral and matching',
  description: 'A real person listens to your goals, then personally connects you with a vetted, licensed local real estate agent in Southeast Wisconsin. Free, with no obligation.',
  provider: { '@id': origin + '/#business' },
  areaServed: citiesByCounty().map((g) => ({ '@type': 'AdministrativeArea', name: g.county + ', Wisconsin' })),
  offers: {
    '@type': 'Offer',
    price: 0,
    priceCurrency: 'USD',
    description: 'Free for homeowners and buyers, with no obligation.',
  },
};
---
<Layout current="home" jsonLd={[service]}>
  <!-- HERO -->
  <section class="hero">
    <svg class="shore" viewBox="0 0 400 700" fill="none" aria-hidden="true">
      <path d="M400 0 C 250 90, 330 200, 230 300 C 150 380, 260 470, 170 560 C 110 620, 200 660, 150 700 L400 700 Z" fill="#15315E" opacity=".07"/>
      <path d="M400 30 C 270 120, 340 220, 250 320 C 180 395, 280 485, 200 575 C 150 630, 230 670, 190 700" stroke="#15315E" stroke-width="1.4" opacity=".25"/>
      <g fill="#2456C9">
        <circle cx="300" cy="150" r="5"/><circle cx="252" cy="320" r="5"/><circle cx="232" cy="470" r="5"/><circle cx="205" cy="595" r="5"/>
      </g>
    </svg>
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow">Southeast Wisconsin · Personal agent matching</p>
        <h1>Get Personally Matched With a <em>Trusted</em> Local Agent.</h1>
        <p class="lead">Tell us about your move and a real person reaches out. After a genuine conversation about your goals, we connect you with the right local agent and resources. A tailored fit, never a name pulled from a queue.</p>
        <ul class="hero-trust">
          <li><span class="dot"></span> Vetted local agents</li>
          <li><span class="dot"></span> Free for homeowners</li>
          <li><span class="dot"></span> No obligation</li>
        </ul>
      </div>
      <LeadForm />
    </div>
  </section>

  <!-- TRUST BAR -->
  <!-- TRUST BAR: measured figures, not claims. Regenerates on every import. -->
  <div class="trustbar">
    <div class="wrap">
      <span><b>{fmtNum(region.activeListings)}</b> homes for sale</span>
      <span><b>{fmtPrice(region.typicalPrice)}</b> typical asking price</span>
      <span><b>{fmtNum(region.daysOnMarket)}</b> days on market</span>
      <span><b>{region.marketCount}</b> markets, {region.countyCount} counties</span>
      <span><b>$0</b> cost to homeowners</span>
    </div>
    <p class="trustbar-note">Southeast Wisconsin listing data, {trendMonth}. Prices are a 12-month median of asking prices, not closed sales.</p>
  </div>

  <!-- HOW IT WORKS -->
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">A personal process</p>
        <h2>How RRS Connects You</h2>
        <p>A real person guides you from first hello to the right local agent. Here's how it works.</p>
      </div>
      <div class="steps">
        <div class="step"><div class="num">1</div><h3>Tell Us About Your Move</h3><p>Share a few quick details about your situation, where you are, your timeline, and what you're hoping to do. It takes about a minute.</p></div>
        <div class="step"><div class="num">2</div><h3>We Reach Out and Listen</h3><p>A real person from RRS contacts you for a genuine conversation and takes time to understand your goals, your home, and what matters most to you.</p></div>
        <div class="step"><div class="num">3</div><h3>We Connect You With the Right Agent</h3><p>We partner with a team of trusted agents across Southeast Wisconsin. Based on that conversation, we personally connect you with the right one for your situation, plus any other resources you need. A tailored fit, with no pressure and no obligation.</p></div>
      </div>
      <div class="center" style="margin-top:36px"><a class="btn btn-ghost" href="/how-it-works/">See how it works →</a></div>
    </div>
  </section>

  <!-- THE DECADE: two measured numbers that make the case by themselves -->
  <section class="section decade">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">The last {trend.years} years</p>
        <h2>Fewer Homes, Higher Prices</h2>
      </div>
      <div class="decade-grid">
        <div class="decade-stat">
          <p class="value">+{pctUp}%</p>
          <p class="label">Asking prices</p>
          <p class="sub">{fmtPrice(trend.fromPrice)} in {trend.fromYear} to {fmtPrice(trend.toPrice)} over the past year</p>
        </div>
        <div class="decade-stat">
          <p class="value">-{pctDown}%</p>
          <p class="label">Homes on the market</p>
          <p class="sub">{fmtNum(trend.fromListings)} a month in {trend.fromYear} to {fmtNum(trend.toListings)} a month over the past year</p>
        </div>
      </div>
      <p class="decade-note">
        Measured across all {region.marketCount} Southeast Wisconsin markets we track, comparing 12-month periods
        at each end so a quiet month cannot skew it. Asking prices, not closed sales. Less choice and higher prices
        is exactly the market where the agent you pick matters, which is the part we help with.
      </p>
      <div class="center" style="margin-top:30px">
        <a class="btn btn-ghost" href="/home-values/compare/">Compare all {region.marketCount} markets →</a>
      </div>
    </div>
  </section>

  <!-- SERVICE AREA -->
  <section class="section area">
    <div class="wrap split">
      <div>
        <p class="eyebrow">Where we work</p>
        <h2>Built for Southeast Wisconsin</h2>
        <p class="intro">From the lakefront to the Kettle Moraine, we match homeowners and buyers across the eight counties of Southeast Wisconsin with agents who live and work here.</p>
        <ul class="cities">
          {featuredCities.map((c) => <li>{c.name}</li>)}
        </ul>
      </div>
      <div class="map-card">
        <ServiceMap />
      </div>
    </div>
  </section>

  <!-- WHY -->
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Why homeowners use us</p>
        <h2>The Local Advantage, Without the Legwork</h2>
        <p>One quick form replaces hours of researching, comparing, and second-guessing which agent to trust.</p>
      </div>
      <div class="why-grid">
        <div class="why-card"><div class="ic">📍</div><h3>Truly Local Agents</h3><p>We match you with agents who work your specific area, not out-of-town crews chasing leads two counties over.</p></div>
        <div class="why-card"><div class="ic">🛡️</div><h3>Vetted and Licensed</h3><p>Every agent we recommend is a licensed Wisconsin professional with a real track record we've checked.</p></div>
        <div class="why-card"><div class="ic">🤝</div><h3>No Pressure, Ever</h3><p>You're never obligated to list or buy. Get matched, ask questions, and decide entirely on your own timeline.</p></div>
        <div class="why-card"><div class="ic">💸</div><h3>Free for You</h3><p>Our matching service costs homeowners nothing. We're here to make a stressful decision a little easier.</p></div>
        <div class="why-card"><div class="ic">⚡</div><h3>A Real Person, Not a Queue</h3><p>You're never dropped into an anonymous lead pool. We reach out personally, talk it through, and guide you to the right fit.</p></div>
        <div class="why-card"><div class="ic">🧭</div><h3>Honest Guidance First</h3><p>Read our local guides before you ever fill out a form. Informed homeowners make better moves.</p></div>
      </div>
    </div>
  </section>

  <!-- GUIDES -->
  <section class="section area">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Local guides</p>
        <h2>Know Before You Move</h2>
        <p>Straight answers to the questions Southeast Wisconsin homeowners and buyers actually ask.</p>
      </div>
      <div class="blog-grid">
        {posts.map((post, i) => (
          <a class="post" href={`/guides/${post.slug}/`}>
            <div class={`thumb ${post.data.hero ? 'has-img' : (thumbs[i] || '')}`}>
              {post.data.hero && <img src={post.data.hero} alt={post.data.heroAlt || post.data.title} width="1600" height="900" loading="lazy" />}
              <span>{post.data.category}</span>
            </div>
            <div class="body">
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
              <div class="more">Read the guide →</div>
            </div>
          </a>
        ))}
      </div>
      <div class="center"><a class="btn btn-ghost" href="/guides/">View all guides →</a></div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta">
    <div class="wrap">
      <h2>Ready to Find Your Agent?</h2>
      <p>Get matched with a trusted Southeast Wisconsin real estate agent today. Free, no obligation, no pressure.</p>
      <a class="btn btn-primary" href="/get-started/">Find my agent →</a>
    </div>
  </section>
</Layout>
