---
import Layout from '../layouts/Layout.astro';
---
<Layout
  current=""
  title="Thank You | RRS Realty Group"
  description="Thanks for reaching out to RRS Realty Group. A real person will personally follow up to match you with a vetted local Southeast Wisconsin agent."
  noindex={true}
>
  <section class="page-head">
    <div class="wrap">
      <p class="eyebrow">Request received</p>
      <h1>Thanks, We Got Your Request</h1>
      <p>A real person from RRS Realty Group will personally reach out to start the conversation, no automated queue, no random handoff.</p>
    </div>
  </section>

  <section class="section" style="padding-top:40px">
    <div class="wrap">
      <div class="steps">
        <div class="step"><div class="num">1</div><h3>We Review Your Details</h3><p>We read what you shared about your move, your area, and your timeline so the conversation starts with context.</p></div>
        <div class="step"><div class="num">2</div><h3>A Real Person Reaches Out</h3><p>Someone from RRS personally contacts you to understand your goals. You're never a file dropped into a pool.</p></div>
        <div class="step"><div class="num">3</div><h3>We Match You With the Right Agent</h3><p>Based on that conversation, we connect you with a vetted local agent who fits your situation. No pressure, no obligation.</p></div>
      </div>

      <div class="center" style="margin-top:36px">
        <p style="color:var(--ink-soft);margin-bottom:18px">While you wait, our local guides answer the questions Southeast Wisconsin homeowners and buyers ask most.</p>
        <a class="btn btn-ghost" href="/guides/">Read the local guides →</a>
      </div>
    </div>
  </section>

  <section class="cta">
    <div class="wrap">
      <h2>Have a Quick Question in the Meantime?</h2>
      <p>Email us anytime at <a href="mailto:rrsrealtygroup@gmail.com" style="color:#fff;text-decoration:underline">rrsrealtygroup@gmail.com</a>.</p>
      <a class="btn btn-primary" href="/">Back to home</a>
    </div>
  </section>
</Layout>
