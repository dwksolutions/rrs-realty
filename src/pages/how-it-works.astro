---
import Layout from '../layouts/Layout.astro';

// FAQ content drives both the visible cards below and the FAQPage structured
// data, so the two never drift (Google requires them to match).
const faqs = [
  { q: 'Is It Really Free?', a: 'Yes. Our matching service costs homeowners and buyers nothing. There is no fee to get connected with an agent.' },
  { q: 'Am I Obligated to Anything?', a: 'No. Getting matched does not commit you to listing, buying, or hiring anyone. You are always free to walk away.' },
  { q: 'Who Are the Agents?', a: 'Licensed Wisconsin real estate professionals who work in your specific area and have a track record we have reviewed.' },
  { q: 'How Fast Will I Hear Back?', a: 'Quickly. A real person from RRS reaches out personally to start the conversation, so you are not left waiting in a queue for a stranger to pick up.' },
  { q: 'What Areas Do You Cover?', a: 'All eight counties of Southeast Wisconsin, from Milwaukee and Waukesha to Racine, Kenosha, and the surrounding communities.' },
  { q: "What If It's Not a Good Fit?", a: 'Just let us know. The goal is the right match for you, not a forced one, there is no pressure to continue.' },
];

const faqSchema = {
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<Layout
  current="how"
  title="How RRS Realty Group Works, Get Matched With a Local Agent"
  description="See how RRS Realty Group personally connects Southeast Wisconsin homeowners and buyers with the right local agent, a real conversation and a hand-matched introduction, not a generic lead queue. Free, no obligation."
  jsonLd={[faqSchema]}
>
  <section class="page-head">
    <div class="wrap">
      <p class="eyebrow">A personal process</p>
      <h1>How RRS Connects You With the Right Agent</h1>
      <p>No anonymous lead queue, no random handoff. A real person reaches out, listens, and personally matches you to the right local agent. Here's exactly what happens.</p>
    </div>
  </section>

  <section class="section" style="padding-top:48px">
    <div class="wrap">
      <div class="steps">
        <div class="step"><div class="num">1</div><h3>Tell Us About Your Move</h3><p>Fill out a short form with where your home is, your timeline, and what you're hoping to do. It's just enough for us to start a real conversation, no commitment.</p></div>
        <div class="step"><div class="num">2</div><h3>We Reach Out and Listen</h3><p>A real person from RRS personally contacts you to talk it through, your goals, your home, your situation. You're never a file in a queue waiting for a stranger to call.</p></div>
        <div class="step"><div class="num">3</div><h3>We Connect You With the Right Agent</h3><p>We partner with a team of trusted agents. With your situation in mind, we personally connect you with the right one for you, plus any other resources you need. A tailored fit, on your terms, with no obligation.</p></div>
      </div>
      <p class="intro" style="max-width:44rem;margin:32px auto 0;text-align:center">Ready to dig into specifics? See what matters most when <a href="/sell/">selling your home</a> or <a href="/buy/">buying a home</a> in Southeast Wisconsin.</p>
    </div>
  </section>

  <section class="section area">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Common questions</p>
        <h2>What to Expect</h2>
      </div>
      <div class="why-grid">
        {faqs.map((f) => (
          <div class="why-card"><h3>{f.q}</h3><p>{f.a}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="cta">
    <div class="wrap">
      <h2>Ready to Get Matched?</h2>
      <p>It takes under two minutes and there's no obligation. Tell us about your move and we'll handle the rest.</p>
      <a class="btn btn-primary" href="/get-started/">Find my agent →</a>
    </div>
  </section>
</Layout>
