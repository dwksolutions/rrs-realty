---
import Layout from '../layouts/Layout.astro';
---
<Layout
  current=""
  title="Page Not Found | RRS Realty Group"
  description="That page could not be found. Head back home or explore how RRS Realty Group matches Southeast Wisconsin homeowners and buyers with vetted local agents."
  noindex={true}
>
  <section class="page-head">
    <div class="wrap">
      <p class="eyebrow">Error 404</p>
      <h1>We Couldn't Find That Page</h1>
      <p>The page you're looking for may have moved or never existed. Here's where most people go next.</p>
    </div>
  </section>

  <section class="section" style="padding-top:40px">
    <div class="wrap">
      <div class="why-grid">
        <a class="why-card" href="/" style="text-decoration:none"><h3>Home</h3><p>Start over from the top and see how our free agent matching works.</p></a>
        <a class="why-card" href="/sell/" style="text-decoration:none"><h3>Sell a Home</h3><p>Get matched with a vetted local listing agent in Southeast Wisconsin.</p></a>
        <a class="why-card" href="/buy/" style="text-decoration:none"><h3>Buy a Home</h3><p>Find a local buyer agent who knows the neighborhoods you want.</p></a>
        <a class="why-card" href="/home-values/" style="text-decoration:none"><h3>Market Data</h3><p>Browse current market snapshots for cities across the eight counties.</p></a>
        <a class="why-card" href="/guides/" style="text-decoration:none"><h3>Local Guides</h3><p>Straight answers on selling, buying, pricing, and choosing an agent.</p></a>
        <a class="why-card" href="/how-it-works/" style="text-decoration:none"><h3>How It Works</h3><p>See the simple, personal three-step matching process.</p></a>
      </div>
    </div>
  </section>

  <section class="cta">
    <div class="wrap">
      <h2>Ready to Get Matched?</h2>
      <p>Tell us about your move and a real person will personally reach out. Free, no obligation.</p>
      <a class="btn btn-primary" href="/get-started/">Find my agent →</a>
    </div>
  </section>
</Layout>
