---
// LeadForm, wired to Formspree.
// SETUP: create a free form at https://formspree.io, set its email to
// rrsrealtygroup@gmail.com, copy the form's endpoint ID, and paste it below.
const FORMSPREE_ID = 'xpqgqjab'; // RRS Realty Group lead form → rrsrealtygroup@gmail.com
const action = `https://formspree.io/f/${FORMSPREE_ID}`;
const { heading = 'Find Your Agent', sub = "Takes under 2 minutes. A real person will personally reach out to talk it through.", intent = 'Selling' } = Astro.props;
---
<form class="lead-card lead-form" action={action} method="POST">
  <h2>{heading}</h2>
  <p class="sub">{sub}</p>

  <div class="seg" role="group" aria-label="What do you need help with">
    <label><input type="radio" name="intent" value="Selling" checked={intent === 'Selling'} /><span>I'm Selling</span></label>
    <label><input type="radio" name="intent" value="Buying" checked={intent === 'Buying'} /><span>I'm Buying</span></label>
  </div>

  <div class="field" style="margin-top:13px">
    <label for="name">Full Name</label>
    <input id="name" name="name" type="text" required autocomplete="name" placeholder="Jane Homeowner" />
  </div>
  <div class="field-row">
    <div class="field">
      <label id="zipLabel" for="zip">Property ZIP Code</label>
      <input id="zip" name="zip" type="text" required autocomplete="postal-code" placeholder="53151" />
    </div>
    <div class="field">
      <label for="phone">Phone</label>
      <input id="phone" name="phone" type="tel" required autocomplete="tel" placeholder="(262) 555-0142" />
    </div>
  </div>
  <div class="field-row">
    <div class="field">
      <label id="typeLabel" for="homeType">Type of Home</label>
      <select id="homeType" name="homeType">
        <option value="">Select a type…</option>
        <option>Single-family home</option>
        <option>Condo</option>
        <option>Townhouse</option>
        <option>Multi-family</option>
        <option>Land / lot</option>
        <option>Other</option>
      </select>
    </div>
    <div class="field">
      <label id="priceLabel" for="priceRange">Estimated Home Value</label>
      <select id="priceRange" name="priceRange">
        <option value="">Select a range…</option>
        <option>Under $200k</option>
        <option>$200k-$300k</option>
        <option>$300k-$400k</option>
        <option>$400k-$500k</option>
        <option>$500k-$750k</option>
        <option>$750k+</option>
      </select>
    </div>
  </div>
  <div class="field-row">
    <div class="field">
      <label id="timelineLabel" for="timeline">Timeline</label>
      <select id="timeline" name="timeline" required>
        <option value="">When are you looking to move?</option>
        <option value="ASAP, ready now">As soon as possible</option>
        <option value="1-3 months">In the next 1-3 months</option>
        <option value="3-6 months">In 3-6 months</option>
        <option value="6+ months">More than 6 months out</option>
        <option value="Just exploring">Just exploring my options</option>
      </select>
    </div>
    <div class="field">
      <label for="contactPref">Preferred Contact</label>
      <select id="contactPref" name="contactPref">
        <option value="">No preference</option>
        <option>Call</option>
        <option>Text</option>
        <option>Email</option>
      </select>
    </div>
  </div>
  <div class="field">
    <label for="email">Email</label>
    <input id="email" name="email" type="email" required autocomplete="email" placeholder="you@email.com" />
  </div>
  <div class="field">
    <label for="message">Anything We Should Know? (Optional)</label>
    <textarea id="message" name="message" rows="2" placeholder="Timeline, type of home, neighborhood…"></textarea>
  </div>

  <!-- routes the notification subject -->
  <input type="hidden" name="_subject" value="New RRS Realty Group lead" />
  <!-- simple spam honeypot -->
  <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />

  <button class="btn btn-primary" type="submit">Match Me With an Agent →</button>
  <p class="fine consent">
    By submitting, you agree to our <a href="/terms/">Terms</a> and <a href="/privacy/">Privacy Policy</a>,
    and you consent to be contacted by RRS Realty Group and your matched agent at the number and email
    you provide, including by call, prerecorded/autodialed message, and text, about your inquiry.
    Consent is not a condition of any purchase. Msg &amp; data rates may apply; reply STOP to opt out.
  </p>
</form>
<script>
  // Labels adapt to whether the visitor is buying or selling, so a buyer is
  // never asked for a "Property ZIP Code" or "Estimated Home Value".
  const COPY = {
    Selling: { zip: 'Property ZIP Code', zipPh: '53151', type: 'Type of Home', price: 'Estimated Home Value', timeline: 'Selling Timeline' },
    Buying:  { zip: 'Preferred City, Area or ZIP', zipPh: 'Brookfield or 53045', type: 'Type of Home Wanted', price: 'Purchase Budget', timeline: 'Buying Timeline' },
  };
  document.querySelectorAll('.lead-form').forEach((form) => {
    const zipLabel = form.querySelector('#zipLabel');
    const zipInput = form.querySelector('#zip');
    const typeLabel = form.querySelector('#typeLabel');
    const priceLabel = form.querySelector('#priceLabel');
    const timelineLabel = form.querySelector('#timelineLabel');
    const apply = () => {
      const checked = form.querySelector('input[name="intent"]:checked');
      const c = COPY[checked && checked.value === 'Buying' ? 'Buying' : 'Selling'];
      if (zipLabel) zipLabel.textContent = c.zip;
      if (zipInput) zipInput.placeholder = c.zipPh;
      if (typeLabel) typeLabel.textContent = c.type;
      if (priceLabel) priceLabel.textContent = c.price;
      if (timelineLabel) timelineLabel.textContent = c.timeline;
    };
    form.querySelectorAll('input[name="intent"]').forEach((r) => r.addEventListener('change', apply));
    apply();
  });
</script>
